# Where the API is, when it is not on the same origin as this bundle.
#
# Leave it unset for local development (Vite proxies /api to 127.0.0.1:8000) and
# for the single-process build, where `psok serve` serves both halves and /api is
# a relative path.
#
# Set it for a split deployment -- a Vercel frontend against a Render backend.
# Scheme and host, no trailing slash, no /api on the end: api.js adds that.
#
#   VITE_API_BASE=https://psok-api.onrender.com
#
# It is read at BUILD time, not at run time, so changing it means redeploying
# the frontend rather than restarting anything.
VITE_API_BASE=
